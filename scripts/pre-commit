#!/usr/bin/env bash
# Pre-commit: lint staged Python with ruff before allowing the commit.
# Installed by scripts/install-git-hooks.sh — see that script to (re)install.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v ruff >/dev/null 2>&1; then
    if ! python3 -m ruff --version >/dev/null 2>&1; then
        echo "pre-commit: ruff not found, installing (pip install --user ruff)..." >&2
        pip install --user -q ruff || {
            echo "pre-commit: could not install ruff — skipping lint for this commit." >&2
            echo "pre-commit: install manually with 'pip install --user ruff' to enable it." >&2
            exit 0
        }
    fi
fi

RUFF="ruff"
command -v ruff >/dev/null 2>&1 || RUFF="python3 -m ruff"

echo "pre-commit: running ruff check..."
if ! $RUFF check .; then
    echo "pre-commit: ruff check failed — fix the above, or 'ruff check --fix .', then re-commit." >&2
    exit 1
fi

echo "pre-commit: running ruff format --check..."
if ! $RUFF format --check .; then
    echo "pre-commit: formatting is off — run 'ruff format .' and re-commit." >&2
    exit 1
fi

echo "pre-commit: ruff OK."
